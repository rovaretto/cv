% cvstyle.sty -- layout and helper macros for the CV
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}

% ---------- Page & fonts ----------
\RequirePackage[a4paper,left=1.6cm,right=1.6cm,top=1.4cm,bottom=1.4cm]{geometry}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[default,semibold]{sourcesanspro}
\RequirePackage[english]{babel}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{fontawesome5}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{needspace}
\RequirePackage{ifthen}
\RequirePackage{multicol}
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage[hidelinks]{hyperref}

\definecolor{accent}{HTML}{1F4E79}
\definecolor{subtle}{HTML}{5A6270}
\definecolor{rulecol}{HTML}{C9D3DE}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.05}
\raggedbottom

% Footer: name + page counter
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[R]{\footnotesize\color{subtle}Emanuele Rovaretto \,\textbar\, \thepage/\pageref*{LastPage}}

% ---------- Header ----------
% \cvheader{Name}{Title}{info line}
\newcommand{\cvheader}[3]{%
  {\fontsize{26}{30}\selectfont\bfseries\color{accent}#1\par}
  \vspace{3pt}
  {\large\color{subtle}#2\par}
  \vspace{5pt}
  {\small #3\par}
  \vspace{4pt}
  {\color{accent}\rule{\linewidth}{1.2pt}}\par
}
\newcommand{\infoitem}[2]{{\color{accent}#1}\,#2}
\newcommand{\infosep}{\hspace{1.2em}}

% ---------- Sections ----------
\newcommand{\cvsection}[1]{%
  \Needspace{5\baselineskip}%
  \vspace{12pt}%
  {\color{accent}\large\bfseries\MakeUppercase{#1}}\par
  \vspace{1pt}%
  {\color{rulecol}\rule{\linewidth}{0.6pt}}\par
  \vspace{5pt}%
}

% ---------- Experience ----------
% \cventry{Role}{Organization}{Location}{Dates}
\newcommand{\cventry}[4]{%
  \Needspace{4\baselineskip}%
  {\bfseries #1}\hfill{\small\color{subtle}#4}\par
  \ifthenelse{\equal{#2}{}}{}{%
    {\color{accent}#2}\ifthenelse{\equal{#3}{}}{}{\,{\color{subtle}\textbar\ #3}}\par}%
  \vspace{1pt}%
}

\setlist[itemize]{label={\color{accent}\small\textbullet}, leftmargin=1.3em,
  itemsep=1pt, topsep=2pt, parsep=0pt, partopsep=0pt}
\newenvironment{cvitems}{\begin{itemize}}{\end{itemize}\vspace{6pt}}

% ---------- Skills ----------
% \skillgroup{Label}{comma-separated items}
\newcommand{\skillgroup}[2]{%
  \Needspace{2\baselineskip}%
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}p{4.3cm}>{\raggedright\arraybackslash}X@{}}
    \leavevmode{\bfseries\color{accent}#1} & #2
  \end{tabularx}\par
  \vspace{3pt}%
}

% ---------- Education ----------
% \eduentry{Institution}{Location}{Degree / line}{Date}{Details (may be empty)}
\newcommand{\eduentry}[5]{%
  \Needspace{4\baselineskip}%
  {\bfseries #3}\hfill{\small\color{subtle}#4}\par
  {\color{accent}#1}\,{\color{subtle}\textbar\ #2}\par
  \ifthenelse{\equal{#5}{}}{}{{\small #5\par}}%
  \vspace{7pt}%
}

% ---------- Projects ----------
% \cvproject{Title}{Description}{Main tools}{Key skills}
\newcommand{\cvproject}[4]{%
  \Needspace{6\baselineskip}%
  {\bfseries\color{accent}#1}\par
  \vspace{1pt}%
  #2\par
  \vspace{2pt}%
  {\small{\bfseries\color{subtle}Main tools:}~#3\par}
  {\small{\bfseries\color{subtle}Key skills:}~#4\par}
  \vspace{9pt}%
}

% ---------- Privacy note ----------
\newcommand{\privacynote}[1]{%
  \vfill
  {\scriptsize\color{subtle}#1\par}
}

\endinput
